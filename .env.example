# All of these are optional. Copy this file to `.env.local` for local use; on
# GitHub, set them as repository variables (Settings → Secrets and variables →
# Actions → Variables).

# Set automatically by the deploy workflow — only override for a custom domain.
# NEXT_PUBLIC_SITE_ORIGIN=https://example.com
# NEXT_PUBLIC_BASE_PATH=

# Google Analytics / Search Console
# NEXT_PUBLIC_GOOGLE_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GOOGLE_VERIFICATION=
